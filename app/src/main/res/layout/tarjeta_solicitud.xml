<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="120dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:layout_marginTop="@dimen/margin_4dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_4dp"
        app:cardCornerRadius="@dimen/borderRadius">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:id="@+id/colorCard"
                android:layout_width="0dp"
                android:layout_weight="0.40"
                android:layout_height="match_parent"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="@color/cart">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/imgFoto"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:src="@drawable/ic_file"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_8dp"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtcodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SOLICITUD DE CARGA"
                    android:textColor="@color/moderado"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/margin_8dp"/>

                <TextView
                    android:id="@+id/tvEmpleadoSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_default_card_4dp"
                    tools:text="Android Name"
                    android:textColor="@color/colordark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/lyEstadosolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/margin_4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTADO: "
                        android:textAlignment="textStart"
                        android:layout_marginEnd="@dimen/margin_8dp"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEstadoSolicitud"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="txtestado"
                        android:textAlignment="center"
                        android:textColor="@color/moderado"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyNumHoja"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/margin_4dp">

                    <TextView
                        android:id="@+id/tvNumHoja"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NUM. HOJA DE CARGA: "
                        android:textAlignment="textStart"
                        android:layout_marginEnd="@dimen/margin_8dp"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNumHoja"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="txthoja"
                        android:textAlignment="center"
                        android:textColor="@color/moderado"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFechaSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Android Version"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_marginTop="@dimen/margin_default_card_4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_8dp"/>

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
