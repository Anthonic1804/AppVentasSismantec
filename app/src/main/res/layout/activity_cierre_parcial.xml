<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CierreParcial">

    <LinearLayout
        android:id="@+id/lyEncabezado"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:padding="5dp"
        android:background="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvInventarioHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_8dp"
            android:text="CIERRE PARCIAL"
            android:textAlignment="center"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/Titulo"
            android:textStyle="bold"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/lyBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/margin_8dp"
        app:layout_constraintTop_toBottomOf="@id/lyEncabezado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:text="FECHA:"
                android:textStyle="bold"
                android:textSize="16dp"
                android:layout_marginStart="@dimen/margin_default_16dp"/>

            <EditText
                android:id="@+id/etFechaReporte"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/border_textbox"
                android:clickable="false"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="10dp"
                android:ems="10"
                android:focusable="false"
                android:inputType="date"
                android:layout_marginStart="@dimen/margin_default_16dp"
                android:textColor="@color/colorHint"
                android:hint="@string/date_default" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

