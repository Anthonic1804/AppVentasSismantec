<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recicler"
    tools:context=".Configuracion">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/imgbtnatras"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_arrow_back_24"
                app:tint="@color/colorAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="297dp"
                android:layout_marginBottom="8dp"
                android:text="AJUSTES DE LA APLICACIÓN"
                android:textAlignment="viewStart"
                android:textColor="@color/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/imgbtnatras"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/logoEmpresa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_default_16dp"
                    app:cardElevation="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp">

                        <TextView
                            android:id="@+id/encaImagen"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_margin="16dp"
                            android:text="LOGO DE LA EMPRESA"
                            android:textColor="@color/colorPrimaryDark"
                            android:textColorLink="@color/colorPrimaryDark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imgLogoEmpresa"
                            android:layout_width="250dp"
                            android:layout_height="100dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/encaImagen"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardConfig"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:cardElevation="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/logoEmpresa">

                    <Button
                        android:id="@+id/btnCargarConfig"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:background="@drawable/border_btnenviar"
                        android:text="Configuraciones APP"
                        android:textColor="@color/colorAccent"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView9"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="325dp"
                    android:layout_margin="16dp"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:cardElevation="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardConfig"
                    app:layout_constraintBottom_toTopOf="@+id/cardVersiones">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/textView10"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_margin="16dp"
                            android:text="DATOS DE CONEXIÓN"
                            android:textColor="@color/colorPrimaryDark"
                            android:textColorLink="@color/colorPrimaryDark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/btnConfigServidor"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_configuracion"
                            android:layout_marginTop="@dimen/margin_8dp"
                            android:layout_marginEnd="@dimen/margin_default_16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/lyServidor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_default_16dp"
                            android:background="@drawable/spinner_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView10">

                            <Spinner
                                android:id="@+id/spServidor"
                                android:layout_width="match_parent"
                                android:layout_height="55dp" />

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/lyNombreServidor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default_16dp"
                            android:layout_marginEnd="@dimen/margin_default_16dp"
                            android:layout_marginTop="@dimen/margin_4dp"
                            android:layout_marginBottom="@dimen/margin_4dp"
                            android:enabled="false"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:hint="NOMBRE SERVIDOR"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/lyServidor">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtNombreServidor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textAlignment="center"
                                android:textSize="18sp"
                                android:textColor="@color/colorHint"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/lyIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default_16dp"
                            android:layout_marginEnd="@dimen/margin_default_16dp"
                            android:layout_marginBottom="@dimen/margin_4dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/lyNombreServidor">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:startIconDrawable="@drawable/ic_computer"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:hint="@string/server">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtip"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:textColor="@color/colorHint"
                                    android:textSize="18sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <CheckBox
                                android:id="@+id/cbxActivarSSL"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".3"
                                android:text="SSL"
                                android:textSize="18sp"
                                android:textColor="@color/colorHint"
                                android:enabled="false" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/lyPuerto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginStart="@dimen/margin_default_16dp"
                            android:layout_marginEnd="@dimen/margin_default_16dp"
                            android:layout_marginTop="@dimen/margin_4dp"
                            android:layout_marginBottom="@dimen/margin_4dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/lyIp">

                            <com.google.android.material.textfield.TextInputLayout

                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/puerto"
                                app:startIconDrawable="@drawable/ic_network"
                                android:layout_marginEnd="@dimen/margin_4dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtpuerto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:textColor="@color/colorHint"
                                    android:textSize="18sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/lyPuntoVenta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/punto_de_venta"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                app:startIconDrawable="@drawable/ic_pventa"
                                android:layout_marginStart="@dimen/margin_4dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/tvPuntoVenta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:textSize="18sp"
                                    android:textColor="@color/colorHint"/>

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <Button
                            android:id="@+id/btnActualizarServidor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:background="@drawable/border_btnenviar"
                            android:text="ACTUALIZAR"
                            android:textColor="@color/colorAccent"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lyPuerto"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardVersiones"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:cardElevation="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardView9">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/lblversiones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:text="VISUALIZACIÓN DE INVENTARIO"
                            android:textColor="@color/colorPrimaryDark"
                            android:textColorLink="@color/colorPrimaryDark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/linearLayout3"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical|center_horizontal"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/lblversiones">


                            <androidx.cardview.widget.CardView
                                android:id="@+id/cwlista"
                                android:layout_width="130dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                app:cardElevation="8dp">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="5dp">

                                    <Switch
                                        android:id="@+id/swlista"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="LISTADO  "
                                        android:textStyle="bold"
                                        android:textSize="12sp"
                                        android:thumb="@drawable/thumb"
                                        android:track="@drawable/track"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <ImageView
                                        android:id="@+id/imageView6"
                                        android:layout_width="100dp"
                                        android:layout_height="80dp"
                                        android:layout_margin="@dimen/margin_default_16dp"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toBottomOf="@+id/swlista"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:srcCompat="@drawable/ic_listainventario_v3" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cwminiatura"
                                android:layout_width="130dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                app:cardElevation="8dp">


                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="5dp">

                                    <Switch
                                        android:id="@+id/swminiatura"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="MINIATURA  "
                                        android:textStyle="bold"
                                        android:textSize="12sp"
                                        android:thumb="@drawable/thumb"
                                        android:track="@drawable/track"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <ImageView
                                        android:id="@+id/imageView10"
                                        android:layout_width="100dp"
                                        android:layout_height="80dp"
                                        android:layout_margin="@dimen/margin_default_16dp"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toBottomOf="@+id/swminiatura"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:srcCompat="@drawable/ic_miniatura_v3" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </androidx.cardview.widget.CardView>


                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFormaImpresion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_default_16dp"
                            android:text="FORMA DE IMPRESIÓN"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textAlignment="center"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
                            />

                        <LinearLayout
                            android:id="@+id/lyFormaImpresion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvFormaImpresion">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cwIntegrada"
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="16dp"
                                    app:cardElevation="8dp">

                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="5dp">

                                        <Switch
                                            android:id="@+id/swIntegrada"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="INTEGRADA "
                                            android:textStyle="bold"
                                            android:textSize="12sp"
                                            android:thumb="@drawable/thumb"
                                            android:track="@drawable/track"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toTopOf="parent" />

                                        <ImageView
                                            android:id="@+id/imgIntegrada"
                                            android:layout_width="100dp"
                                            android:layout_height="80dp"
                                            android:layout_margin="@dimen/margin_default_16dp"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toBottomOf="@+id/swIntegrada"
                                            app:layout_constraintBottom_toBottomOf="parent"
                                            app:srcCompat="@drawable/ic_integrada_v3" />

                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cwBluetooth"
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    app:cardElevation="8dp">


                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="5dp">

                                        <Switch
                                            android:id="@+id/swBluetooth"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="BLUETOOTH  "
                                            android:textStyle="bold"
                                            android:textSize="12sp"
                                            android:thumb="@drawable/thumb"
                                            android:track="@drawable/track"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toTopOf="parent" />

                                        <ImageView
                                            android:id="@+id/imgBluetooth"
                                            android:layout_width="100dp"
                                            android:layout_height="80dp"
                                            android:layout_margin="@dimen/margin_default_16dp"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toBottomOf="@+id/swBluetooth"
                                            app:layout_constraintBottom_toBottomOf="parent"
                                            app:srcCompat="@drawable/ic_bluetooth_v3" />

                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/lyImpresor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/lyNombreImpresor"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="16dp"
                                    android:hint="NOMBRE IMPRESOR"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/lyIp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/txtImpresor"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:textColor="@color/colorHint"
                                        android:textSize="18sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <Button
                                    android:id="@+id/btnImpresor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/btn_eliminarpedido"
                                    android:layout_marginStart="@dimen/margin_default_16dp"
                                    android:layout_marginEnd="@dimen/margin_default_16dp"
                                    android:text="ALMACENAR IMPRESOR"
                                    android:textColor="@color/colorAccent"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/cardVersiones" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblInventarioCero"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default_16dp"
                            android:text="AGREGAR PRODUCTO SIN EXISTENCIA EN PEDIDOS"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/lyFormaImpresion" />

                        <Switch
                            android:id="@+id/swSinExistencias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/thumb"
                            android:track="@drawable/track"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/lblInventarioCero"
                            app:layout_constraintTop_toBottomOf="@+id/lyFormaImpresion" />

                        <LinearLayout
                            android:id="@+id/lyNumeroCaja"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="@dimen/margin_default_16dp"
                            android:layout_marginEnd="@dimen/margin_default_16dp"
                            android:layout_marginTop="@dimen/margin_4dp"
                            android:layout_marginBottom="@dimen/margin_default_16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/lblInventarioCero">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/margin_4dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="15sp"
                                    android:gravity="center_vertical"
                                    android:text="NÚM. DE CAJA :"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight=".5"
                                android:layout_marginStart="@dimen/margin_4dp"
                                android:background="@drawable/spinner_bg">
                                <Spinner
                                    android:id="@+id/spNumeroCaja"
                                    android:layout_width="match_parent"
                                    android:textAlignment="center"
                                    android:layout_height="40dp" />
                            </LinearLayout>

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnReconectar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/border_btnenviar"
                    android:text="Reconectar Servidor"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardVersiones" />

                <Button
                    android:id="@+id/btnBuscarUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/border_btnactualizar"
                    android:text="@string/buscar_actualizaciones"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnReconectar" />

                <TextView
                    android:id="@+id/tvVersionActualApp"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="VERSION APP"
                    android:textAlignment="center"
                    android:textColor="@color/colorPrimaryDark"
                    android:textColorLink="@color/colorPrimaryDark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnBuscarUpdate" />

                <view
                    android:id="@+id/vistaalerta"
                    class="androidx.appcompat.widget.ActionMenuView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>