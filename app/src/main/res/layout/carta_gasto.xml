<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:minHeight="130dp"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:layout_marginTop="@dimen/margin_4dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_4dp"
        app:cardCornerRadius="@dimen/borderRadius">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="130dp"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:id="@+id/cvColorAbono"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="130dp"
                android:layout_weight="0.35"
                app:cardBackgroundColor="@color/cart">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="130dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/imgFoto"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:src="@drawable/ic_cobrar"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="130dp"
                android:layout_marginStart="@dimen/margin_8dp"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDescripcionGasto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8dp"
                    tools:text="DESCRIPCION"
                    android:textColor="@color/colordark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmpleadoGasto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4dp"
                    tools:text="SUCURSAL"
                    android:textColor="@color/colorPrimaryDark"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvTotalGasto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        tools:text="TOTAL"
                        android:textColor="@color/colorPrimaryDark"
                        android:layout_marginTop="@dimen/margin_default_card_4dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/margin_8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnEliminarGasto"/>

                    <TextView
                        android:id="@+id/tvFechaGasto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        tools:text="FECHA"
                        android:textColor="@color/colorPrimaryDark"
                        android:layout_marginTop="@dimen/margin_default_card_4dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalGasto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnEliminarGasto"/>

                    <ImageView
                        android:id="@+id/btnEliminarGasto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_delete_abono"
                        android:layout_marginBottom="@dimen/margin_8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
