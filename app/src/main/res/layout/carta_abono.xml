<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:minHeight="120dp"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:layout_marginTop="@dimen/margin_4dp"
        android:layout_marginStart="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_4dp"
        app:cardCornerRadius="@dimen/borderRadius">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="0.35"
                android:minHeight="120dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="@color/cart">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/imgFoto"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:src="@drawable/ic_cobrar"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_8dp"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCodigoAbono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="CODIGO"
                    android:textColor="@color/moderado"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvClienteAbono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_default_card_4dp"
                    tools:text="NOMBRE CLIENTE"
                    android:textColor="@color/colordark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalAbono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="TOTAL"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_marginTop="@dimen/margin_default_card_4dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_8dp"/>

                <TextView
                    android:id="@+id/tvFechaAbono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="FECHA"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_marginTop="@dimen/margin_default_card_4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
