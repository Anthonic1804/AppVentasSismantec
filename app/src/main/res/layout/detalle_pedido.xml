<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/margin_8dp"
    android:background="@color/detallePedido"
    android:padding="5dp"
    app:cardCornerRadius="5dp"
    app:cardBackgroundColor="@color/detallePedido">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/txtcantidad"
            android:layout_width="5dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TextView"
            android:textAlignment="center"
            android:textColor="@color/colordark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtdescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="TextView"
            android:textAlignment="textStart"
            android:textColor="@color/moderado"
            android:textStyle="bold" />

        <!-- CÓDIGO NUEVO: Campo para mostrar el Precio Unitario (Precio U) -->
        <TextView
            android:id="@+id/txtprecioU"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="P.U: $0.00"
            android:textAlignment="center"
            android:textColor="@color/colordark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtprecio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TextView"
            android:textAlignment="textEnd"
            android:textColor="@color/colordark"
            android:textStyle="bold" />

    </LinearLayout>


</androidx.cardview.widget.CardView>
